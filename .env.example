# cc-llm-wiki — 환경 변수 예시
# 실제 .env 파일은 .gitignore 처리됨. 본 파일을 복사해 사용:
#   cp .env.example .env
#   <편집>
# 토큰이 없으면 모든 routine 은 dry-run 모드로 동작 (네트워크 호출 안 함).

# ───── Slack (P4 daily-digest, weekly-lint 알림) ─────
# Incoming Webhook URL. https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# OAuth Bot Token (mcp__slack 용, 채널 글쓰기). xoxb- 로 시작
SLACK_BOT_TOKEN=
# 기본 채널 (Webhook 이 채널 고정 시 불필요)
SLACK_DEFAULT_CHANNEL=#wiki-digest

# ───── Cloudflare Pages (P4 publish-multilang) ─────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=cc-llm-wiki

# ───── OpenAI (P5 GraphRAG ingest_graph.py) ─────
# LangChain LLMGraphTransformer 가 entity/relation 추출에 사용
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ───── Neo4j (P5 graph-sync) ─────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ───── GitHub (모든 routine 의 PR 생성) ─────
# gh auth login 으로 처리하는 게 권장. 토큰 직접 쓰려면 아래.
GITHUB_TOKEN=

# ───── 동작 모드 ─────
# dry-run=1 이면 모든 외부 호출이 stdout 으로 출력만 (실제 네트워크 X)
DRY_RUN=1
