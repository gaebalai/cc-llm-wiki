# env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Obsidian local state
vault/.obsidian/workspace*
vault/.obsidian/cache
# 플러그인 바이너리는 Obsidian 이 자동 다운로드. community-plugins.json 만 commit 해서 명세 유지
vault/.obsidian/plugins/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Claude Code local (settings.local.json은 글로벌 ~/.config/git/ignore 가 처리)
.claude/queue/*
!.claude/queue/.gitkeep
plans/

# infra runtime
infra/neo4j/data/
infra/neo4j/logs/
infra/neo4j/plugins/*
!infra/neo4j/plugins/.gitkeep

# python
__pycache__/
*.pyc
.venv/
venv/

# node
node_modules/

# documents
docs/*
